# .gitignore
# lista o que o Git NÃO deve enviar para o github: arquivos de banco de dados
# gerados pelo programa, pastas temporárias do python e ambientes virtuais.

# Ignora arquivos de banco de dados gerados pelo programa
*.db
*.sqlite

# Ignora a pasta de cache que o Python cria sozinho
__pycache__/

# Ignora a pasta de ambiente virtual
venv/

# Arquivo com a senha do banco de dados.
.env